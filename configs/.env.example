APP_ENV=development
LOG_LEVEL=info

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s

# Local PostgreSQL from docker-compose.yml (published on 5433 to avoid
# clashing with an existing server on 5432). If you already run PostgreSQL on
# 5432 and created the learning_notebook database there, change the port.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/learning_notebook?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_AUTO_MIGRATE=true
